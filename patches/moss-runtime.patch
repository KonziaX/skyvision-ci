+#include <functional>
+#include <string>
+
+namespace vqa { namespace rt {
+
+struct Options {
+    double interval = 1.0;
+    int frames = 1;
+    int answer_tokens = 512;
+    int observe_tokens = 128;
+    int max_pixels = 262144;
+    double temperature = 0;
+    int top_k = 0;
+    double top_p = 1;
+    double repetition_penalty = 1.05;
+    int repeat_last_n = 128;
+    bool recover_repeats = false;
+    std::string video_size = "1920x1080";
+    double capture_fps = 30;
+    std::string pixel_format;
+    double warmup = 2;
+    int jpeg_quality = 2;
+    bool system = true;
+    std::string system_prompt;
+    std::string initial_prompt =
+        "请用中文简短描述当前画面，通常一到三句话。持续观察与用户问题相关的新变化，"
+        "没有新变化或已经回答完毕时输出 <|silence|>，不要反复描述相同内容。";
+};
+
+inline bool read_number(const std::string & raw, const char * name, double lo,
+                        double hi, double & value, std::string & error) {
+    if (raw.empty()) return true;
+    char * end = nullptr;
+    errno = 0;
+    const double v = std::strtod(raw.c_str(), &end);
+    if (errno || end == raw.c_str() || *end || !std::isfinite(v) || v < lo || v > hi) {
+        error = std::string("invalid ") + name + " (allowed " + std::to_string(lo) + ".." + std::to_string(hi) + ")";
+        return false;
+    }
+    value = v;
+    return true;
+}
+
+inline bool read_integer(const std::string & raw, const char * name, int lo,
+                         int hi, int & value, std::string & error) {
+    if (raw.empty()) return true;
+    char * end = nullptr;
+    errno = 0;
+    const long v = std::strtol(raw.c_str(), &end, 10);
+    if (errno || end == raw.c_str() || *end || v < lo || v > hi) {
+        error = std::string("invalid ") + name + " (allowed " + std::to_string(lo) + ".." + std::to_string(hi) + ")";
+        return false;
+    }
+    value = (int)v;
+    return true;
+}
+
+inline bool parse_options(const std::function<std::string(const char *)> & get,
+                          Options & o, std::string & error) {
+    if (!read_number(get("interval"), "interval", 0.2, 60, o.interval, error) ||
+        !read_integer(get("frames"), "frames", 1, 8, o.frames, error) ||
+        !read_integer(get("n"), "n", 1, 8192, o.answer_tokens, error) ||
+        !read_integer(get("observe-n"), "observe-n", 1, 8192, o.observe_tokens, error) ||
+        !read_integer(get("max-pixels"), "max-pixels", 4096, 16777216, o.max_pixels, error) ||
+        !read_number(get("temperature"), "temperature", 0, 2, o.temperature, error) ||
+        !read_integer(get("top-k"), "top-k", 0, 1000, o.top_k, error) ||
+        !read_number(get("top-p"), "top-p", 0.01, 1, o.top_p, error) ||
+        !read_number(get("repeat-penalty"), "repeat-penalty", 1, 2, o.repetition_penalty, error) ||
+        !read_integer(get("repeat-last-n"), "repeat-last-n", 0, 4096, o.repeat_last_n, error) ||
+        !read_number(get("capture-fps"), "capture-fps", 1, 120, o.capture_fps, error) ||
+        !read_number(get("warmup"), "warmup", 0, 15, o.warmup, error) ||
+        !read_integer(get("jpeg-quality"), "jpeg-quality", 1, 31, o.jpeg_quality, error)) return false;
+    const std::string size = get("video-size");
+    if (!size.empty() && size != "auto") {
+        const size_t x = size.find('x');
+        int w = 0, h = 0;
+        if (x == std::string::npos ||
+            !read_integer(size.substr(0, x), "video width", 16, 7680, w, error) ||
+            !read_integer(size.substr(x + 1), "video height", 16, 4320, h, error) || !w || !h) {
+            if (error.empty()) error = "video-size must be WIDTHxHEIGHT or auto";
+            return false;
+        }
+        o.video_size = size;
+    } else if (size == "auto") o.video_size.clear();
+    const std::string pixel = get("pixel-format");
+    if (!pixel.empty() && pixel != "auto") {
+        for (unsigned char c : pixel) {
+            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_')) {
+                error = "invalid pixel-format"; return false;
+            }
+        }
+        if (pixel.size() > 32) { error = "pixel-format is too long"; return false; }
+        o.pixel_format = pixel;
+    }
+    const std::string sys = get("sys");
+    if (!sys.empty() && sys != "0" && sys != "1") { error = "sys must be 0 or 1"; return false; }
+    if (!sys.empty()) o.system = sys == "1";
+    const std::string recover = get("recover-repeats");
+    if (!recover.empty() && recover != "0" && recover != "1") {
+        error = "recover-repeats must be 0 or 1"; return false;
+    }
+    if (!recover.empty()) o.recover_repeats = recover == "1";
+    if (!get("prompt").empty()) o.initial_prompt = get("prompt");
+    o.system_prompt = get("system-prompt");
+    if (o.initial_prompt.size() > 8192 || o.system_prompt.size() > 8192) {
+        error = "prompt exceeds 8192 bytes"; return false;
+    }
+    return true;
+}
+
+// The tokenizer may divide one Chinese character across several tokens.
+struct Utf8Output {
+    std::string carry;
+    std::string append(const std::string & piece) {
+        std::string s = carry + piece;
+        carry.clear();
+        size_t emit = s.size();
+        const size_t lo = s.size() > 4 ? s.size() - 4 : 0;
+        for (size_t k = s.size(); k > lo; --k) {
+            const unsigned char b = (unsigned char)s[k - 1];
+            if (b < 0x80) break;
+            if (b >= 0xC0) {
+                const size_t need = b >= 0xF0 ? 4 : b >= 0xE0 ? 3 : 2;
+                if (s.size() - (k - 1) < need) emit = k - 1;
+                break;
+            }
+        }
+        if (emit < s.size()) { carry = s.substr(emit); s.resize(emit); }
+        return s;
+    }
+};
+
+// Quote an argument for CreateProcess (Windows) or popen's shell (POSIX).
+inline std::string quote_arg(const std::string & value) {
+#ifdef _WIN32
+    std::string out = "\"";
+    size_t slashes = 0;
+    for (char c : value) {
+        if (c == '\\') { ++slashes; continue; }
+        if (c == '"') { out.append(slashes * 2 + 1, '\\'); out += c; }
+        else { out.append(slashes, '\\'); out += c; }
+        slashes = 0;
+    }
+    out.append(slashes * 2, '\\');
+    return out + '"';
+#else
+    std::string out = "'";
+    for (char c : value) out += c == '\'' ? "'\\''" : std::string(1, c);
+    return out + '\'';
+#endif
+}
+
+}} // namespace vqa::rt
